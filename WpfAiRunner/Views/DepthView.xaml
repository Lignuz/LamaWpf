<local:BaseAiView x:Class="WpfAiRunner.Views.DepthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfAiRunner.Views"
             Background="{StaticResource BgDark}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnPickModel" Content="📂 Load Depth Model..." Click="BtnPickModel_Click"/>
                <TextBlock x:Name="TxtModel" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="5,0,15,0" Text="(no model)"/>

                <CheckBox x:Name="ChkUseGpu" Content="Use GPU" Click="ChkUseGpu_Click" IsChecked="True"/>

                <Button x:Name="BtnOpenImage" Content="🖼️ Open Image" Click="BtnOpenImage_Click"/>

                <TextBlock Text="Style:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="{StaticResource TextSecondary}"/>
                <ComboBox x:Name="CboStyle" Width="120" SelectedIndex="0" VerticalAlignment="Center" 
                          Margin="0,0,10,0" SelectionChanged="CboStyle_SelectionChanged">
                    <ComboBoxItem Content="Inferno"/>
                    <ComboBoxItem Content="Magma"/>
                    <ComboBoxItem Content="Plasma"/>
                    <ComboBoxItem Content="Viridis"/>
                    <ComboBoxItem Content="Grayscale"/>
                </ComboBox>

                <Button x:Name="BtnRun" Content="▶ Estimate Depth" Style="{StaticResource BtnPrimary}" Click="BtnRun_Click" IsEnabled="False"/>

                <TextBlock x:Name="TxtStatus" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="15,0,0,0" Text="Ready."/>

                <ProgressBar x:Name="PbarLoading" Width="100" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="10,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Image x:Name="ImgInput" Stretch="Uniform" 
               MouseLeftButtonDown="ImgInput_MouseLeftButtonDown" 
               SizeChanged="ImgInput_SizeChanged"
               Cursor="Cross"/>

                    <Canvas x:Name="CanvasOverlay" IsHitTestVisible="False"
                Width="{Binding ActualWidth, ElementName=ImgInput}"
                Height="{Binding ActualHeight, ElementName=ImgInput}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="FocusMarker" Width="20" Height="20" 
                     Stroke="Yellow" StrokeThickness="2" Visibility="Collapsed"/>
                    </Canvas>

                    <Border VerticalAlignment="Bottom" Background="#AA000000" CornerRadius="0,0,8,8" Padding="15,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ComboBox x:Name="CboEffectMode" Width="100" Margin="0,0,15,0" SelectedIndex="0" SelectionChanged="CboEffectMode_SelectionChanged">
                                <ComboBoxItem Content="Blur (Focus)"/>
                                <ComboBoxItem Content="B&amp;W (Isolation)"/>
                                <ComboBoxItem Content="Fog (Depth)"/>
                                <ComboBoxItem Content="Sky (Replace)"/>
                            </ComboBox>

                            <Button x:Name="BtnLoadSky" Content="🌅 Load Sky" Visibility="Collapsed" Click="BtnLoadSky_Click" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtEffectLabel" Text="Intensity" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0" FontSize="11"/>
                            <Slider x:Name="SldBlur" Width="150" Minimum="0" Maximum="30" Value="5" VerticalAlignment="Center" ValueChanged="SldBlur_ValueChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Image x:Name="ImgOutput" Stretch="Uniform"/>
                    <Button x:Name="BtnResetFocus" Content="✕ Reset Focus" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="10" Click="BtnResetFocus_Click" Opacity="0.8"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:BaseAiView>